\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Optical acquisition-level parity-1 trajectories across each site's actual acquisitions. Methods use the same recorded observation sequence. Each method retains its own numerical scale; reconstruction, latent distance, fused score, isolation score, SVM margin, RPCA residual and CUSUM are not interchangeable performance metrics. Learned-score lines are five-seed medians with min--max bands. Missing observations remain breaks. The event bracket is shaded. Pre-breach curves are development-exposed because fitting uses the whole declared pre-breach period; post-event points are excluded from fitting.}}{6}{figure.caption.8}\protected@file@percent }
\newlabel{fig:scores}{{4}{6}{Optical acquisition-level parity-1 trajectories across each site's actual acquisitions. Methods use the same recorded observation sequence. Each method retains its own numerical scale; reconstruction, latent distance, fused score, isolation score, SVM margin, RPCA residual and CUSUM are not interchangeable performance metrics. Learned-score lines are five-seed medians with min--max bands. Missing observations remain breaks. The event bracket is shaded. Pre-breach curves are development-exposed because fitting uses the whole declared pre-breach period; post-event points are excluded from fitting}{figure.caption.8}{}}
