{
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "integer",
      "enum": [1, 2]
    },
    "measurement_id": {
      "type": "string",
      "minLength": 1
    },
    "metadata_id": {
      "type": "string",
      "minLength": 1
    },
    "product_id": {
      "type": "string",
      "minLength": 1
    },
    "lake_id": {
      "type": "string",
      "minLength": 1
    },
    "product": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "endpoint": {
      "type": "string",
      "minLength": 1
    },
    "query_id": {
      "type": "string",
      "minLength": 1
    },
    "response_id": {
      "type": "string",
      "minLength": 1
    },
    "roi_id": {
      "type": "string",
      "minLength": 1
    },
    "crs": {
      "type": "string",
      "minLength": 1
    },
    "support_start": {
      "type": "string",
      "minLength": 1
    },
    "support_end": {
      "type": "string",
      "minLength": 1
    },
    "available_at": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "MEASURED",
        "CATALOGUED",
        "NO_DATA",
        "FAILED"
      ]
    },
    "origin": {
      "type": "string",
      "enum": [
        "observational",
        "fixture",
        "simulation"
      ]
    },
    "units": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "availability_policy": {
      "type": "string",
      "enum": [
        "provider-recorded",
        "retrieval-time",
        "acquisition-time-approximation"
      ]
    },
    "qa_id": {
      "type": "string",
      "minLength": 1
    }
    ,"native_sar": {
      "type": "object",
      "properties": {
        "schema_version": {"type": "integer", "const": 1},
        "product_id": {"type": "string", "minLength": 1},
        "product_type": {"type": "string", "const": "GRD"},
        "mode": {"type": "string", "const": "IW"},
        "polarization": {"type": "string", "enum": ["VV", "VH"]},
        "ipf_version": {"type": "string", "minLength": 1},
        "subswath": {"type": "string", "minLength": 1},
        "roles": {
          "type": "object",
          "properties": {
            "measurement": {"$ref": "sar_role_reference.json"},
            "calibration": {"$ref": "sar_role_reference.json"},
            "noise": {"$ref": "sar_role_reference.json"},
            "annotation": {"$ref": "sar_role_reference.json"},
            "manifest": {"$ref": "sar_role_reference.json"}
          },
          "required": ["measurement", "calibration", "noise", "annotation", "manifest"],
          "additionalProperties": false
        },
        "rows": {"type": "integer", "minimum": 1},
        "columns": {"type": "integer", "minimum": 1},
        "dtype": {"type": "string", "enum": ["uint16", "int16", "uint32", "float32", "float64"]},
        "line_offset": {"type": "integer", "minimum": 0},
        "sample_offset": {"type": "integer", "minimum": 0},
        "processing_flags": {
          "type": "object",
          "properties": {
            "input_radiometry": {"type": "string", "const": "RAW_DN"},
            "sigma0_calibration_applied": {"type": "boolean", "const": false},
            "thermal_noise_correction_applied": {"type": "boolean", "const": false},
            "incidence_normalization_applied": {"type": "boolean", "const": false},
            "terrain_correction_applied": {"type": "boolean", "const": false}
          },
          "required": ["input_radiometry", "sigma0_calibration_applied", "thermal_noise_correction_applied", "incidence_normalization_applied", "terrain_correction_applied"],
          "additionalProperties": false
        },
        "noise_status": {"type": "string", "enum": ["SUPPORTED_FIXTURE_POLICY", "UNAVAILABLE_MISSING", "UNAVAILABLE_UNVERIFIED_PRODUCT", "ALREADY_CORRECTED", "UNSUPPORTED_SCHEMA"]}
      },
      "required": ["schema_version", "product_id", "product_type", "mode", "polarization", "ipf_version", "subswath", "roles", "rows", "columns", "dtype", "line_offset", "sample_offset", "processing_flags", "noise_status"],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "measurement_id",
    "metadata_id",
    "product_id",
    "lake_id",
    "product",
    "version",
    "endpoint",
    "query_id",
    "response_id",
    "roi_id",
    "crs",
    "support_start",
    "support_end",
    "available_at",
    "status",
    "origin",
    "units",
    "availability_policy",
    "qa_id"
  ],
  "additionalProperties": false
}
