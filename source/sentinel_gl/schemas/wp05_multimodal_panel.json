{
  "type": "object",
  "required": [
    "schema_version", "bundle_id", "panel_bundle_id", "origin", "mode", "status",
    "research_admissible", "training_admitted", "plan_executable", "research_status",
    "release_status", "fit_transform_state", "fit_transform_status", "arrays_file",
    "inputs", "accepted_inputs", "groups", "panels", "graph_separation",
    "independent_support", "unavailable_dependencies", "missingness_contract", "limitations"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "bundle_id": {"type": "string", "const": "WP05-WP06-ASYNC-DEVELOPMENT-DIAGNOSTIC-V1"},
    "panel_bundle_id": {"type": "string", "minLength": 1},
    "origin": {"type": "string", "const": "RETAINED_PROVIDER_BYTES_DEVELOPMENT_ONLY"},
    "mode": {"type": "string", "const": "DEVELOPMENT_DIAGNOSTIC"},
    "status": {"type": "string", "const": "RAGGED_ASYNCHRONOUS_DIAGNOSTIC_PANEL"},
    "research_admissible": {"type": "boolean", "const": false},
    "training_admitted": {"type": "boolean", "const": false},
    "plan_executable": {"type": "boolean", "const": false},
    "research_status": {"type": "string", "const": "RESEARCH_NOT_READY"},
    "release_status": {"type": "string", "const": "BLOCKED"},
    "fit_transform_state": {"type": "null"},
    "fit_transform_status": {"type": "string", "const": "RAW_VALUES_NO_FITTED_TRANSFORM"},
    "arrays_file": {
      "type": "object", "required": ["path", "bytes", "sha256", "keys", "compression"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "bytes": {"type": "integer", "minimum": 1},
        "sha256": {"type": "string", "pattern": "[0-9a-f]{64}"},
        "keys": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "compression": {"type": "string", "const": "NUMPY_NPZ_DEFLATE"}
      }
    },
    "inputs": {
      "type": "array", "minItems": 1,
      "items": {"type": "object", "required": ["path", "bytes", "sha256", "role"],
        "properties": {"path": {"type": "string", "minLength": 1},
          "bytes": {"type": "integer", "minimum": 1},
          "sha256": {"type": "string", "pattern": "[0-9a-f]{64}"},
          "role": {"type": "string", "minLength": 1}}}
    },
    "accepted_inputs": {
      "type": "object", "required": ["optical_features", "native_sar_execution"],
      "properties": {
        "optical_features": {"type": "object", "required": ["path", "sha256", "bytes", "receipt_path", "receipt_status", "independent_replay_status"], "properties": {
          "path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "[0-9a-f]{64}"},
          "bytes": {"type": "integer", "minimum": 1}, "receipt_path": {"type": "string", "minLength": 1},
          "receipt_status": {"type": "string"}, "independent_replay_status": {"type": "string"}}},
        "native_sar_execution": {"type": "object", "required": ["path", "sha256", "bytes", "research_admissible", "archive_sha256"], "properties": {
          "path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "[0-9a-f]{64}"},
          "bytes": {"type": "integer", "minimum": 1}, "research_admissible": {"type": "boolean", "const": false},
          "archive_sha256": {"type": "string", "pattern": "[0-9a-f]{64}"}}}
      }
    },
    "groups": {"type": "array", "minItems": 1, "items": {"type": "object", "required": [
      "group_id", "sensor", "site_id", "acquisition", "site_exposure", "scope_membership",
      "sampling_graph", "provenance_graph", "support_id", "source_id", "product_id", "grid",
      "channels", "unavailable_channels", "arrays", "qa", "lineage", "admission"],
      "properties": {"group_id": {"type": "string", "minLength": 1},
        "sensor": {"type": "string", "enum": ["SENTINEL_1_IW_GRD", "SENTINEL_2_OPTICAL"]},
        "site_id": {"type": "string", "minLength": 1}, "channels": {"type": "array", "minItems": 1},
        "unavailable_channels": {"type": "array"}, "acquisition": {"type": "object"},
        "scope_membership": {"type": "object"}, "sampling_graph": {"type": "object"},
        "provenance_graph": {"type": "object"}, "grid": {"type": "object"}, "arrays": {"type": "object"},
        "qa": {"type": "object"}, "lineage": {"type": "object"}, "admission": {"type": "object"}}}},
    "panels": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["panel_id", "site_id", "site_exposure", "group_ids", "sampling_graph", "provenance_graph", "scope_membership"], "properties": {
      "panel_id": {"type": "string", "minLength": 1}, "site_id": {"type": "string", "minLength": 1},
      "site_exposure": {"type": "string"}, "group_ids": {"type": "array", "minItems": 2, "items": {"type": "string"}},
      "sampling_graph": {"type": "object"}, "provenance_graph": {"type": "object"}, "scope_membership": {"type": "object"}}}},
    "graph_separation": {"type": "object", "required": ["G_S", "G_P", "shared_grid_is_physical_registration"], "properties": {
      "G_S": {"type": "object"}, "G_P": {"type": "object"}, "shared_grid_is_physical_registration": {"type": "boolean", "const": false}}},
    "independent_support": {"type": "object", "required": ["value", "status", "reason"], "properties": {
      "value": {"type": "null"}, "status": {"type": "string", "const": "UNKNOWN"}, "reason": {"type": "string", "minLength": 1}}},
    "unavailable_dependencies": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["channel_id", "status", "value", "reason"], "properties": {
      "channel_id": {"type": "string", "minLength": 1}, "status": {"type": "string", "const": "UNAVAILABLE"},
      "value": {"type": "null"}, "reason": {"type": "string", "minLength": 1}}}},
    "missingness_contract": {"type": "object", "required": ["invalid_source_values_canonicalized_to_nan", "observed_validity_masks_separate_from_QA", "research_admissibility_mask_all_false", "absent_channels_omitted_with_explicit_status", "no_interpolation_forward_fill_or_repeated_source", "tensor_padding_neutral_value", "padding_neutral_value_is_never_observation", "natural_missingness_and_artificial_targets_are_distinct"], "properties": {
      "invalid_source_values_canonicalized_to_nan": {"type": "boolean", "const": true},
      "observed_validity_masks_separate_from_QA": {"type": "boolean", "const": true},
      "research_admissibility_mask_all_false": {"type": "boolean", "const": true},
      "absent_channels_omitted_with_explicit_status": {"type": "boolean", "const": true},
      "no_interpolation_forward_fill_or_repeated_source": {"type": "boolean", "const": true},
      "tensor_padding_neutral_value": {"type": "number"},
      "padding_neutral_value_is_never_observation": {"type": "boolean", "const": true},
      "natural_missingness_and_artificial_targets_are_distinct": {"type": "boolean", "const": true}}},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  }
}
