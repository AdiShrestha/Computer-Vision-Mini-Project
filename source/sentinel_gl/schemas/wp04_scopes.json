    }, "required": ["G_S", "G_P"], "additionalProperties": false},
    "role_separation": {"type": "string", "const": "EXPLICIT_FOUR_ROLE_KEYS_EMPTY_ROLES_ALLOWED_IN_NON_EXECUTABLE_DRAFT"},
