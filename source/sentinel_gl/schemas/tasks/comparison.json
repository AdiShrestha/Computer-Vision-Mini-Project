{
  "type": "object",
  "required": ["schema_version", "task_id", "task_type", "origin", "scope_role", "source_ids", "method_ids", "pairs"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "task_id": {"type": "string", "minLength": 1},
    "task_type": {"type": "string", "const": "COMPARISON"},
    "origin": {"type": "string", "enum": ["observational", "fixture"]},
    "scope_role": {"type": "string", "enum": ["fitting", "development_validation", "threshold_calibration", "evaluation"]},
    "source_ids": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "method_ids": {"type": "array", "items": {"type": "string"}, "minItems": 2},
    "pairs": {"type": "array", "items": {"type": "object", "required": ["pair_id", "source_ids", "physical_unit_id", "method_a", "method_b", "metric_id", "status", "value_a", "value_b", "reason"]}, "minItems": 1}
  },
  "additionalProperties": false
}
