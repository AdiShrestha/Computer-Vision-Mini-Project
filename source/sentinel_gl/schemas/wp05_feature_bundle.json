{
  "type": "object",
  "required": ["schema_version", "bundle_id", "origin", "status", "research_status", "plan_executable", "release_status", "research_admissible", "input_bundle_path", "input_bundle_sha256", "source_count", "record_count", "records"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "bundle_id": {"type": "string", "const": "WP05-OPTICAL-DEVELOPMENT-FEATURES-V1"},
    "origin": {"type": "string", "const": "RETAINED_PROVIDER_BYTES_DEVELOPMENT_ONLY"},
    "status": {"type": "string", "const": "LOCAL_OPTICAL_FEATURES_QUARANTINED"},
    "research_status": {"type": "string", "const": "RESEARCH_NOT_READY"},
    "plan_executable": {"type": "boolean", "const": false},
    "release_status": {"type": "string", "const": "BLOCKED"},
    "research_admissible": {"type": "boolean", "const": false},
    "input_bundle_path": {"type": "string", "minLength": 1},
    "input_bundle_sha256": {"type": "string", "pattern": "[0-9a-f]{64}"},
    "source_count": {"type": "integer", "minimum": 1},
    "record_count": {"type": "integer", "minimum": 1},
    "records": {"type": "array", "minItems": 1, "items": {"$ref": "wp05_feature_record.json"}}
  },
  "additionalProperties": false
}
