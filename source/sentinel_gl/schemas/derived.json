{
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "artifact_id": {
      "type": "string",
      "minLength": 1
    },
    "origin": {
      "type": "string",
      "enum": [
        "observational",
        "fixture",
        "simulation"
      ]
    },
    "parents": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "measurements": {
      "type": "array",
      "items": {"$ref": "measurement.json"},
      "minItems": 1
    }
  },
  "required": [
    "schema_version",
    "artifact_id",
    "origin",
    "parents",
    "measurements"
  ],
  "additionalProperties": false
}
