{
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "artifact_id": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "[a-f0-9]{64}"
          },
          "origin": {
            "type": "string",
            "enum": [
              "observational",
              "fixture",
              "simulation"
            ]
          },
          "parents": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          }
        },
        "required": [
          "artifact_id",
          "path",
          "sha256",
          "origin",
          "parents"
        ],
        "additionalProperties": false
      }
    },
    "measurements": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "[a-f0-9]{64}"
      }
    },
    "requests": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "[a-f0-9]{64}"
      }
    }
  },
  "required": [
    "schema_version",
    "artifacts",
    "measurements"
  ],
  "additionalProperties": false
}
