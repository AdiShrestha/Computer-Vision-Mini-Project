{
  "type": "object",
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "schedule_id": {"type": "string", "minLength": 1},
    "cutoff": {"type": "object", "properties": {
      "original": {"type": "string", "minLength": 1}, "utc": {"type": "string", "minLength": 1},
      "meaning": {"type": "string", "const": "STRICT_PRE_EVENT_SUPPORT_CUTOFF_EXCLUSIVE"},
      "phase_specific_onset_asserted": {"type": "boolean", "const": false}
    }, "required": ["original", "utc", "meaning", "phase_specific_onset_asserted"], "additionalProperties": false},
    "cadence_and_context": {"type": "object", "properties": {
      "status": {"type": "string", "const": "UNRESOLVED"},
      "context_window_days": {"type": "null"}, "stride_days": {"type": "null"},
      "reason": {"type": "string", "minLength": 1}
    }, "required": ["status", "context_window_days", "stride_days", "reason"], "additionalProperties": false},
    "rows": {"type": "array", "minItems": 2, "items": {"$ref": "wp04_schedule_row.json"}},
    "exposure": {"type": "object", "properties": {
      "calendar": {"$ref": "wp04_exposure.json"}, "eligible": {"$ref": "wp04_exposure.json"}
    }, "required": ["calendar", "eligible"], "additionalProperties": false},
    "research_admissible": {"type": "boolean", "const": false}
  },
  "required": ["schema_version", "schedule_id", "cutoff", "cadence_and_context", "rows", "exposure", "research_admissible"],
  "additionalProperties": false
}
