{
  "type": "object",
  "properties": {
    "schema_version": {"type": "integer", "const": 2},
    "source_manifest_id": {"type": "string", "const": "WP04-RETAINED-SOURCES-DRAFT-002"},
    "status": {"type": "string", "const": "SOURCE_BYTES_HASHED_MEASUREMENT_AND_RIGHTS_ADMISSION_BLOCKED"},
    "source_items": {"type": "array", "minItems": 2, "items": {
      "type": "object",
      "properties": {
        "source_id": {"type": "string", "minLength": 1},
        "source_kind": {"type": "string", "const": "SENTINEL_2_C1_L2A_PRODUCT"},
        "product_id": {"type": "string", "minLength": 1},
        "product_uri": {"type": "string", "minLength": 1},
        "site_id": {"type": "string", "minLength": 1},
        "site_scope": {"type": "string", "const": "DEVELOPMENT_EXPOSED"},
        "site_join_status": {"type": "string", "const": "ROI_COVERED_BY_ALL_FOUR_SOURCE_ASSETS_WITH_NO_ALIGNMENT_HALO"},
        "historical_inspection": {"$ref": "wp04_historical_inspection.json"},
        "current_decode": {"$ref": "wp04_current_decode.json"},
        "acquisition_support": {"type": "object", "properties": {
          "status": {"type": "string", "const": "VERIFIED_PRODUCT_METADATA"},
          "start": {"type": "string", "minLength": 1}, "end": {"type": "string", "minLength": 1}
        }, "required": ["status", "start", "end"], "additionalProperties": false},
        "time_axes": {"type": "object", "properties": {
          "acquisition": {"$ref": "wp04_time_axis.json"},
          "product_generation": {"$ref": "wp04_time_axis.json"},
          "publication": {"$ref": "wp04_time_axis.json"},
          "retrieval": {"$ref": "wp04_time_axis.json"},
          "historical_availability": {"$ref": "wp04_time_axis.json"},
          "execution": {"$ref": "wp04_time_axis.json"}
        }, "required": ["acquisition", "product_generation", "publication", "retrieval", "historical_availability", "execution"], "additionalProperties": false},
        "availability": {"type": "object", "properties": {
          "status": {"type": "string", "const": "UNVERIFIED"},
          "at": {"type": "null"}, "evidence_id": {"type": "null"}, "evidence_sha256": {"type": "null"},
          "reason": {"type": "string", "minLength": 1}
        }, "required": ["status", "at", "evidence_id", "evidence_sha256", "reason"], "additionalProperties": false},
        "rights": {"type": "object", "properties": {
          "status": {"type": "string", "const": "UNVERIFIED_SOURCE_SPECIFIC_TERMS"},
          "reason": {"type": "string", "minLength": 1}
        }, "required": ["status", "reason"], "additionalProperties": false},
        "admission": {"type": "string", "const": "SOURCE_BYTES_ACCEPTED_FOR_LOCAL_DEVELOPMENT_PROVENANCE_ONLY_MEASUREMENTS_NOT_ADMITTED"},
        "assets": {"type": "array", "minItems": 4, "items": {"$ref": "wp04_asset.json"}}
      },
      "required": ["source_id", "source_kind", "product_id", "product_uri", "site_id", "site_scope", "site_join_status", "historical_inspection", "current_decode", "acquisition_support", "time_axes", "availability", "rights", "admission", "assets"],
      "additionalProperties": false
    }},
    "observations": {"type": "array", "items": {"type": "object", "additionalProperties": false}},
    "failed_attempts": {"type": "array", "minItems": 1, "items": {"$ref": "wp04_failed_attempt.json"}},
    "asset_hash_inventory": {"type": "array", "minItems": 17, "items": {"$ref": "wp04_hash_record.json"}},
    "measurement_admission": {"type": "string", "const": "BLOCKED"},
    "research_admissible": {"type": "boolean", "const": false}
  },
  "required": ["schema_version", "source_manifest_id", "status", "source_items", "observations", "failed_attempts", "asset_hash_inventory", "measurement_admission", "research_admissible"],
  "additionalProperties": false
}
