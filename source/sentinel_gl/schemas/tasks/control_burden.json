{
  "type": "object",
  "required": ["schema_version", "task_id", "task_type", "origin", "scope_role", "source_ids", "method_ids", "schedule", "declarations", "exposure_intervals", "episodes"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "task_id": {"type": "string", "minLength": 1},
    "task_type": {"type": "string", "const": "CONTROL_BURDEN"},
    "origin": {"type": "string", "enum": ["observational", "fixture"]},
    "scope_role": {"type": "string", "enum": ["fitting", "development_validation", "threshold_calibration", "evaluation"]},
    "source_ids": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "method_ids": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "schedule": {"type": "array", "items": {"type": "object", "required": ["window_id", "source_ids", "support_start", "support_end", "decision_at", "eligibility_status", "reason"]}, "minItems": 1},
    "declarations": {"type": "array", "items": {"type": "object", "required": ["window_id", "method_id", "source_ids", "status", "declaration_at", "reason"]}, "minItems": 1},
    "exposure_intervals": {"type": "array", "items": {"type": "object", "required": ["exposure_id", "physical_unit_id", "source_ids", "start_at", "end_at"]}},
    "episodes": {"type": "array", "items": {"type": "object", "required": ["episode_id", "physical_unit_id", "method_id", "declaration_window_id", "source_ids", "start_at", "end_at"]}}
  },
  "additionalProperties": false
}
