{
  "type": "object",
  "required": ["schema_version", "record_id", "source_id", "site_id", "product_id", "product_uri", "origin", "site_exposure", "support_id", "query_point", "time_axes", "scope_membership", "sampling_unit", "lineage", "grid", "support", "scl", "channels", "candidate_rule", "admission"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "record_id": {"type": "string", "minLength": 1},
    "source_id": {"type": "string", "minLength": 1},
    "site_id": {"type": "string", "minLength": 1},
    "product_id": {"type": "string", "minLength": 1},
    "product_uri": {"type": "string", "minLength": 1},
    "origin": {"type": "string", "const": "provider_download"},
    "site_exposure": {"type": "string", "const": "DEVELOPMENT_EXPOSED"},
    "support_id": {"type": "string", "minLength": 1},
    "query_point": {
      "type": "object",
      "required": ["longitude", "latitude", "status", "lake_geometry_status"],
      "properties": {
        "longitude": {"type": "number"},
        "latitude": {"type": "number"},
        "status": {"type": "string", "const": "PI_QUERY_POINT_ONLY_NOT_LAKE_GEOMETRY_OR_GS_COORDINATE"},
        "lake_geometry_status": {"type": "string", "const": "UNVERIFIED"}
      },
      "additionalProperties": false
    },
    "time_axes": {
      "type": "object",
      "required": ["acquisition", "product_generation", "publication", "retrieval", "historical_availability", "execution"],
      "properties": {
        "acquisition": {"$ref": "wp05_time_axis.json"},
        "product_generation": {"$ref": "wp05_time_axis.json"},
        "publication": {"$ref": "wp05_time_axis.json"},
        "retrieval": {"$ref": "wp05_time_axis.json"},
        "historical_availability": {"$ref": "wp05_time_axis.json"},
        "execution": {"$ref": "wp05_time_axis.json"}
      },
      "additionalProperties": false
    },
    "scope_membership": {
      "type": "object",
      "required": ["site_exposure", "source_membership_count", "context_membership_count", "scientific_source_memberships", "status"],
      "properties": {
        "site_exposure": {"type": "string", "const": "DEVELOPMENT_EXPOSED"},
        "source_membership_count": {"type": "integer", "const": 0},
        "context_membership_count": {"type": "integer", "const": 0},
        "scientific_source_memberships": {"type": "array", "items": {"type": "string"}},
        "status": {"type": "string", "const": "NO_ADMITTED_SCIENTIFIC_SOURCE_MEMBERSHIP"}
      },
      "additionalProperties": false
    },
    "sampling_unit": {
      "type": "object",
      "required": ["physical_unit_id", "status", "reason"],
      "properties": {
        "physical_unit_id": {"type": "null"},
        "status": {"type": "string", "const": "UNRESOLVED"},
        "reason": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "lineage": {
      "type": "object",
      "required": ["wp04_bundle_path", "wp04_bundle_sha256", "sources_path", "sources_sha256", "stage_report_path", "stage_report_sha256", "stage_inventory_path", "stage_inventory_sha256", "decode_report_path", "decode_report_sha256", "decode_inventory_path", "decode_inventory_sha256", "raw_assets", "decoded_assets"],
      "properties": {
        "wp04_bundle_path": {"type": "string", "minLength": 1},
        "wp04_bundle_sha256": {"type": "string", "pattern": "[0-9a-f]{64}"},
        "sources_path": {"type": "string", "minLength": 1},
        "sources_sha256": {"type": "string", "pattern": "[0-9a-f]{64}"},
        "stage_report_path": {"type": "string", "minLength": 1},
        "stage_report_sha256": {"type": "string", "pattern": "[0-9a-f]{64}"},
        "stage_inventory_path": {"type": "string", "minLength": 1},
        "stage_inventory_sha256": {"type": "string", "pattern": "[0-9a-f]{64}"},
        "decode_report_path": {"type": "string", "minLength": 1},
        "decode_report_sha256": {"type": "string", "pattern": "[0-9a-f]{64}"},
        "decode_inventory_path": {"type": "string", "minLength": 1},
        "decode_inventory_sha256": {"type": "string", "pattern": "[0-9a-f]{64}"},
        "raw_assets": {"type": "array", "minItems": 4, "items": {"$ref": "wp05_raw_asset.json"}},
        "decoded_assets": {"type": "array", "minItems": 1, "items": {"$ref": "wp05_decoded_asset.json"}}
      },
      "additionalProperties": false
    },
    "grid": {
      "type": "object",
      "required": ["crs", "shape", "transform", "coordinate_units", "pixel_area_m2", "pixel_area_method", "roi_grid_version"],
      "properties": {
        "crs": {"type": "string", "const": "EPSG:32645"},
        "shape": {"type": "array", "minItems": 2, "items": {"type": "integer", "minimum": 1}},
        "transform": {"type": "array", "minItems": 6, "items": {"type": "number"}},
        "coordinate_units": {"type": "string", "const": "metre"},
        "pixel_area_m2": {"type": "number", "minimum": 0},
        "pixel_area_method": {"type": "string", "const": "ABS_AFFINE_DETERMINANT_AE_MINUS_BD"},
        "roi_grid_version": {"type": "string", "const": "WP03_ACCEPTED_ROI_DECODE_005"}
      },
      "additionalProperties": false
    },
    "support": {
      "type": "object",
      "required": ["roi_cell_count", "analysis_valid_count", "scl_valid_count", "qa_population_id", "qa_population_count", "qa_denominator_id", "qa_denominator_count", "qa_fraction_of_valid_scl", "candidate_population_id", "candidate_population_count", "candidate_denominator_id", "candidate_denominator_count", "candidate_fraction_of_qa_population", "candidate_area_m2", "candidate_area_status", "candidate_area_scope", "candidate_mask_unavailable_count"],
      "properties": {
        "roi_cell_count": {"type": "integer", "minimum": 0},
        "analysis_valid_count": {"type": "integer", "minimum": 0},
        "scl_valid_count": {"type": "integer", "minimum": 0},
        "qa_population_id": {"type": "string", "const": "SCL_CLEAR_CLASSES_4_5_6"},
        "qa_population_count": {"type": "integer", "minimum": 0},
        "qa_denominator_id": {"type": "string", "const": "VALID_SCL_CELLS"},
        "qa_denominator_count": {"type": "integer", "minimum": 0},
        "qa_fraction_of_valid_scl": {"type": ["number", "null"]},
        "candidate_population_id": {"type": "string", "const": "PRELIMINARY_NDWI_MNDWI_SCL_CANDIDATE"},
        "candidate_population_count": {"type": "integer", "minimum": 0},
        "candidate_denominator_id": {"type": "string", "const": "QA_SUPPORTED_CELLS"},
        "candidate_denominator_count": {"type": "integer", "minimum": 0},
        "candidate_fraction_of_qa_population": {"type": ["number", "null"]},
        "candidate_area_m2": {"type": ["number", "null"]},
        "candidate_area_status": {"type": "string", "enum": ["AVAILABLE_WITHIN_ROI", "EMPTY_POPULATION"]},
        "candidate_area_scope": {"type": "string", "const": "OBSERVED_PRELIMINARY_CANDIDATE_AREA_WITHIN_ROI_NOT_LAKE_AREA"},
        "candidate_mask_unavailable_count": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "scl": {
      "type": "object",
      "required": ["valid_denominator_count", "class_counts_and_fractions", "clear_classes", "clear_count", "clear_fraction_of_valid_scl", "status"],
      "properties": {
        "valid_denominator_count": {"type": "integer", "minimum": 0},
        "class_counts_and_fractions": {"type": "array", "minItems": 11, "items": {"$ref": "wp05_scl_class.json"}},
        "clear_classes": {"type": "array", "minItems": 3, "items": {"type": "integer", "enum": [4, 5, 6]}},
        "clear_count": {"type": "integer", "minimum": 0},
        "clear_fraction_of_valid_scl": {"type": ["number", "null"]},
        "status": {"type": "string", "enum": ["AVAILABLE", "EMPTY_POPULATION"]}
      },
      "additionalProperties": false
    },
    "channels": {"type": "array", "minItems": 5, "items": {"$ref": "wp05_channel.json"}},
    "candidate_rule": {
      "type": "object",
      "required": ["mask_version", "rule", "mask_sha256", "interpretation", "four_band_snow_aware_candidate"],
      "properties": {
        "mask_version": {"type": "string", "const": "attempt_2026-10-14_roi_decode_005"},
        "rule": {"type": "string", "const": "NDWI>0 AND MNDWI>0 AND SCL in 4,5,6"},
        "mask_sha256": {"type": "string", "pattern": "[0-9a-f]{64}"},
        "interpretation": {"type": "string", "const": "exploratory candidate pixels within ROI; not lake ground truth"},
        "four_band_snow_aware_candidate": {"$ref": "wp05_unavailable_candidate.json"}
      },
      "additionalProperties": false
    },
    "admission": {
      "type": "object",
      "required": ["status", "research_admissible", "measurement_admission", "scientific_schedule_membership", "2023_operational_decision_status"],
      "properties": {
        "status": {"type": "string", "const": "DEVELOPMENT_ONLY_QUARANTINED"},
        "research_admissible": {"type": "boolean", "const": false},
        "measurement_admission": {"type": "string", "const": "BLOCKED"},
        "scientific_schedule_membership": {"type": "boolean", "const": false},
        "2023_operational_decision_status": {"type": "string", "const": "EXCLUDED_PRODUCT_GENERATED_AFTER_EVENT_CUTOFF"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
