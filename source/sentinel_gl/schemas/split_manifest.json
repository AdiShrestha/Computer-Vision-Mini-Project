{
  "type": "object",
  "properties": {
    "schema_version": {"type": "integer", "const": 2},
    "split_id": {"type": "string", "minLength": 1},
    "protocol": {"type": "string", "const": "four_role_causal_support_graph_v2"},
    "created_at": {"type": "string", "minLength": 1},
    "scope_membership": {
      "type": "object",
      "properties": {
        "fitting": {"$ref": "split_scope_membership.json"},
        "development_validation": {"$ref": "split_scope_membership.json"},
        "threshold_calibration": {"$ref": "split_scope_membership.json"},
        "evaluation": {"$ref": "split_scope_membership.json"}
      },
      "required": ["fitting", "development_validation", "threshold_calibration", "evaluation"],
      "additionalProperties": false
    },
    "schedule_rows": {
      "type": "array",
      "items": {"$ref": "decision_window.json"}
    },
    "graphs": {
      "type": "object",
      "properties": {"G_S": {"type": "object"}, "G_P": {"type": "object"}},
      "required": ["G_S", "G_P"],
      "additionalProperties": false
    },
    "summary": {"type": "object"},
    "metadata": {"type": "object"}
  },
  "required": ["schema_version", "split_id", "protocol", "created_at", "scope_membership", "schedule_rows", "graphs", "summary", "metadata"],
  "additionalProperties": false
}
